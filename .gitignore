# ComfyMind root .gitignore
# Place this file at: C:\ComfyMind_UB\ComfyMind\.gitignore

# Environment variables and secrets
/.env
/.env.*
!/.env.example
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# Node / Vite
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local Python environments
/.venv/
/venv/
/env/
/.conda/

# Local SQLite database and journal files
/artTerapia_app.db
/artTerapia_app.db-*
*.db-journal
*.sqlite-journal
*.sqlite3-journal

# Build and temporary files
*.log
*.tmp
*.temp
.cache/
tmp/
temp/

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Local Codex / tooling scratch files
.codex/
